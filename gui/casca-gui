        more.set_can_focus(False)
        more.set_tooltip_text("pasta, nome ou comando próprio; encerrar sessões; editar host")
        more.connect("clicked", lambda b: self.open_host_menu(b, idx, h))
        box.pack_end(more, False, False, 0)
        row.add(box)
        return row

    def selected(self):
        for row in self.rows.get_children():
            if row.idx == self.sel_idx:
                return row
        return None

    def select(self, row):
        self.sel_idx = row.idx if row is not None else None
        self.paint_pick()

    def paint_pick(self):
        sel = self.selected()
        for row in self.rows.get_children():
            ctx = row.get_style_context()
            (ctx.add_class if row is sel else ctx.remove_class)("sel")
            for n, (b, _name) in enumerate(row.btns):
                pick = row is sel and n == self.sel_agent
                ctx = b.get_style_context()
                (ctx.add_class if pick else ctx.remove_class)("pick")
                b.lab.set_markup(b.plain if pick else b.normal)

    def open_picked(self, row=None):
        row = row or self.selected()
        if row and row.btns:
            self.open_agent(row.idx, row.btns[min(self.sel_agent, len(row.btns) - 1)][1])

    def on_search_key(self, _w, ev):
        k = Gdk.keyval_name(ev.keyval) or ""
        rows = self.rows.get_children()
        if k in ("Down", "Up") and rows:
            sel = self.selected()
            n = rows.index(sel) if sel in rows else -1
            self.select(rows[(n + (1 if k == "Down" else -1)) % len(rows)])
            return True
        if k in ("Left", "Right") and not self.search.get_text():
            self.sel_agent = (self.sel_agent + (1 if k == "Right" else -1)) % max(1, len(self.cfg["agents"]))
            self.paint_pick()
            return True
        return False

    def refresh_live(self, force=False):
        if self.live_busy or (not force and time.time() - self.live_at < 60):
            return
        idxs = [i for i in range(len(self.cfg["hosts"])) if self.st_of(i) == "up"]
        if not idxs:
            return
        self.live_busy = True
        self.render_home()

        def work():
            with ThreadPoolExecutor(3) as ex:
                return dict(zip(idxs, ex.map(lambda i: casca("ls", str(i), timeout=15), idxs)))

        def done(res):
            self.live_busy = False
            self.live_at = time.time()
            for i, r in res.items():
                ss = (r or {}).get("sessions") or []
                if r is None or (r.get("error") and not ss):
                    self.live_err.add(i)
                else:
                    self.live_err.discard(i)
                    self.live[i] = ss
            self.rebuild_side()
            self.render_home()
        in_thread(work, done)

    def show_home(self):
        self.stack.set_visible_child_name("home")
        self.retitle("")
        self.mark_current()
        self.render_home()
        self.refresh_live()
        self.search.grab_focus()

    def show_tabs(self):
        if self.nb.get_n_pages():
            self.stack.set_visible_child_name("tabs")
            t = self.current()
            if t:
                self.retitle(t.title)
                self.seen_current()
                t.grab_focus()
            self.mark_current()

    def on_tabs(self):
        return self.stack.get_visible_child_name() == "tabs"

    # ---------- config / barra lateral ----------
    def load_config(self):
        try:
            self.cfg = json.load(open(CONF))
            self.cfg_mtime = os.stat(CONF).st_mtime
        except Exception as e:
            self.cfg_mtime = 0
            print("config:", e, file=sys.stderr)
        self.cfg.setdefault("hosts", [])
        self.cfg.setdefault("agents", [])
        self.rebuild_side()
        self.render_home()
        for c in self.snips.get_children():
            self.snips.remove(c)
        for s in self.cfg.get("snippets") or []:
            b = Gtk.Button(label=s.get("label", "?"))
            b.set_can_focus(False)
            b.set_tooltip_text("digita na aba: " + s.get("cmd", "").strip())
            b.connect("clicked", lambda _b, s=s: self.feed(s.get("cmd", "")))
            self.snips.pack_start(b, False, False, 0)
        self.snip_state = cls(Gtk.Label(xalign=1), "sub")
        self.snip_state.set_ellipsize(Pango.EllipsizeMode.START)
        self.snips.pack_end(self.snip_state, True, True, 4)
        self.snips.show_all()

    def terms(self):
        return [self.nb.get_nth_page(i) for i in range(self.nb.get_n_pages())]

    def rebuild_side(self):
        for r in self.sess.get_children():
            self.sess.remove(r)
        hosts = self.cfg["hosts"]
        terms = self.terms()
        for t in terms:
            t.row = t.row_dot = t.row_name = t.row_meta = None
        off = [i for i in range(len(hosts)) if self.st_of(i) == "down"]
        order = [i for i in range(len(hosts)) if i not in off] + (off if self.show_off else [])
        for i in order:
            h = hosts[i]
            st = self.st_of(i)
            mine = [t for t in terms if t.idx == i]
            live = {x["name"]: x for x in (self.live.get(i) or [])}
            names = [t.tmux for t in mine] + [n for n in live if n not in {t.tmux for t in mine}]

            row = Gtk.ListBoxRow()
            row.kind, row.idx, row.host = "host", i, h
            card = cls(Gtk.Box(spacing=7), "hostcard")
            if st == "down":
                cls(card, "off")
            card.pack_start(cls(Gtk.Label(label="●" if st != "down" else "○"), st), False, False, 0)
            nm = cls(Gtk.Label(label=h.get("name", "?"), xalign=0), "hostname")
            nm.set_ellipsize(Pango.EllipsizeMode.END)
            nm.set_tooltip_text(h.get("target", ""))
            card.pack_start(nm, True, True, 0)
            if names:
                card.pack_start(cls(Gtk.Label(label=str(len(names))), "badge"), False, False, 0)
            plus = Gtk.Button(label="+")
            plus.set_tooltip_text("nova sessão em " + h.get("name", ""))
            plus.set_can_focus(False)
            plus.connect("clicked", lambda b, i=i, h=h: self.open_host_menu(b, i, h))
            card.pack_end(plus, False, False, 0)
            row.add(card)
            self.sess.add(row)

            for name in names:
                t = next((t for t in mine if t.tmux == name), None)
                info = live.get(name) or {}
                r = Gtk.ListBoxRow()
                r.kind, r.idx, r.host, r.name, r.term = "sess", i, h, name, t
                box = cls(Gtk.Box(spacing=7), "sessrow")
                dot = cls(Gtk.Label(label="●" if t else "○"), "mono", "st-idle")
                dot.set_width_chars(2)
                box.pack_start(dot, False, False, 0)
                mark, color = mark_of(name)
                ml = Gtk.Label()
                ml.set_markup("<span foreground='%s'>%s</span>" % (color, mark))
                box.pack_start(ml, False, False, 0)
                lab = cls(Gtk.Label(label=name[2:] if name.startswith("c-") else name, xalign=0), "sname")
                lab.set_ellipsize(Pango.EllipsizeMode.END)
                box.pack_start(lab, True, True, 0)
                meta = cls(Gtk.Label(label=" ".join(x for x in (info.get("command", ""), age(info.get("activity"))) if x)), "meta")
                box.pack_end(meta, False, False, 0)
                r.box = box
                r.add(box)
                r.set_tooltip_text("aberta nesta janela" if t else "viva no host: clique pra abrir aqui")
                self.sess.add(r)
                if t:
                    cls(box, "open")
                    t.row, t.row_dot, t.row_name, t.row_meta = r, dot, lab, meta
                    self.paint_term(t)
        self.sess.show_all()
        self.side_off.set_visible(bool(off))
        self.side_off_lab.set_text("▾  esconder os sem resposta" if self.show_off else "▸  %d sem resposta" % len(off))
        self.mark_current()

    def mark_current(self):
        cur = self.current() if self.on_tabs() else None
        for t in self.terms():
            if getattr(t, "row", None) is None:
                continue
            ctx = t.row.box.get_style_context()
            (ctx.add_class if t is cur else ctx.remove_class)("current")

    def watch_config(self):
        try:
            if os.stat(CONF).st_mtime != self.cfg_mtime:
                self.load_config()
                self.poll_status()
        except OSError:
            pass
        return True

    def query(self):
        """Texto da busca separado em (filtro de host, agente)."""
        words = self.search.get_text().strip().lower().split()
        agent = ""
        if len(words) > 1 and words[-1] in [a["name"].lower() for a in self.cfg["agents"]]:
            agent = words.pop()
        return " ".join(words), agent

    def match_host(self, h):
        q, _ = self.query()
        return not q or q in (h.get("name", "") + " " + h.get("target", "")).lower()

    def on_sess_row(self, _l, row):
        if row.kind == "host":
            self.open_host_menu(row.get_child(), row.idx, row.host)
        elif row.term is not None:
            self.nb.set_current_page(self.nb.page_num(row.term))
            self.show_tabs()
        else:
            self.open_session(row.idx, row.name)

    def on_search_changed(self, *_):
        self.render_home()

    def on_search_enter(self, *_):
        text = self.search.get_text().strip()
        _q, agent = self.query()
        row = self.selected()
        if row:
            self.search.set_text("")
            if agent:
                self.open_agent(row.idx, agent)
            else:
                self.open_picked(row)
        elif TARGET_RE.match(text):   # conexão rápida: cadastra e abre
            self.cfg["hosts"].append({"name": text, "target": text, "group": "rápido"})
            self.save_config()
            self.search.set_text("")
            self.open_agent(len(self.cfg["hosts"]) - 1, self.cfg["agents"][0]["name"])
        elif text:
            self.toast("nenhum host com esse nome. Pra conectar direto, digite user@host.")

    def poll_status(self):
        in_thread(lambda: casca("status", timeout=15), self.got_status)
        return True

    def got_status(self, res):
        if isinstance(res, list) and res != self.status:
            first = not self.status
            self.status = res
            self.rebuild_side()
            self.render_home()
            if first:
                self.refresh_live(True)

    def paint_status(self):
        pass

    def save_config(self):
        tmp = CONF + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(self.cfg, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, CONF)
        self.load_config()
        self.poll_status()

    def host_dialog(self, idx):
        h = dict(self.cfg["hosts"][idx]) if idx >= 0 else {}
        d = Gtk.Dialog(title="editar host" if idx >= 0 else "novo host", transient_for=self, modal=True)
        d.add_button("cancelar", Gtk.ResponseType.CANCEL)
        if idx >= 0:
            d.add_button("remover", Gtk.ResponseType.REJECT)
        d.add_button("salvar", Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=6, column_spacing=8, margin=12)
        fields = {}
        for r, (key, label, ph) in enumerate([("target", "destino", "user@host (ou local)"), ("name", "nome", ""),
                                              ("group", "grupo", "tailnet"), ("dir", "pasta padrão", "~/projeto"),
                                              ("args", "ssh extra", "-p 2222")]):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, r, 1, 1)
            e = Gtk.Entry(text=h.get(key, ""), placeholder_text=ph, activates_default=True, width_chars=32)
            grid.attach(e, 1, r, 1, 1)
            fields[key] = e
        d.get_content_area().add(grid)
        d.show_all()
        resp = d.run()
        vals = {k: e.get_text().strip() for k, e in fields.items()}
        d.destroy()
        if resp == Gtk.ResponseType.REJECT:
            if any(t.idx >= idx for t in self.terms()):
                self.toast("feche as abas abertas antes de remover um host")
                return
            del self.cfg["hosts"][idx]
            self.live, self.status = {}, []
            self.save_config()
        elif resp == Gtk.ResponseType.OK:
            t = vals["target"]
            if not t or t.startswith("-") or " " in t:
                self.toast("destino deve ser user@host")
                return
            new = {k: v for k, v in vals.items() if v}
            new.setdefault("name", t)
            if idx >= 0:
                self.cfg["hosts"][idx] = new
            else:
                self.cfg["hosts"].append(new)
            self.save_config()

    def toast(self, msg):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=msg)
        d.run()
        d.destroy()

    # ---------- menu do host (o que abrir) ----------
    def open_host_menu(self, anchor, idx, h):
        pop = Gtk.Popover(relative_to=anchor)
        pop.set_position(Gtk.PositionType.BOTTOM)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=10)
        head = Gtk.Box(spacing=8)
        t = Gtk.Label(xalign=0)
        t.set_markup("<b>%s</b>" % esc(h.get("name", "")))
        head.pack_start(t, True, True, 0)
        ed = Gtk.Button(label="editar")
        ed.set_relief(Gtk.ReliefStyle.NONE)
        ed.connect("clicked", lambda *_: (pop.popdown(), self.host_dialog(idx)))
        head.pack_end(ed, False, False, 0)
        box.pack_start(head, False, False, 0)

        flow = Gtk.FlowBox(max_children_per_line=3, min_children_per_line=3, selection_mode=Gtk.SelectionMode.NONE)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        btns = {}
        first = None
        for a in self.cfg["agents"]:
            b = Gtk.Button()
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            nm = Gtk.Label(xalign=0)
            nm.set_markup("<b>%s</b>" % esc(a["name"]))
            sub = cls(Gtk.Label(label="novo", xalign=0), "sub")
            v.pack_start(nm, False, False, 0)
            v.pack_start(sub, False, False, 0)
            b.add(v)
            b.connect("clicked", lambda _b, a=a: (pop.popdown(), self.open_agent(idx, a["name"])))
            flow.add(b)
            btns["c-" + a["name"]] = sub
            first = first or b
        box.pack_start(flow, False, False, 0)

        box.pack_start(cls(Gtk.Label(label="rodando no host", xalign=0), "sub"), False, False, 0)
        live = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        live.pack_start(cls(Gtk.Label(label="consultando…", xalign=0), "sub"), False, False, 0)
        box.pack_start(live, False, False, 0)

        adv = Gtk.Expander(label="sessão com nome, pasta ou comando próprio")
        g = Gtk.Grid(row_spacing=4, column_spacing=6, margin_top=6)
        e_cmd = Gtk.Entry(placeholder_text="comando (vazio = shell)", width_chars=30)
        e_name = Gtk.Entry(placeholder_text="nome da sessão")
        e_dir = Gtk.Entry(placeholder_text="pasta no host", text=h.get("dir", ""))
        go = Gtk.Button(label="abrir")

        def launch(*_):
            cmd, name, d = e_cmd.get_text().strip(), e_name.get_text().strip(), e_dir.get_text().strip()
            args = ["-cmd", cmd] if cmd else []
            name = name or (cmd.split()[0] if cmd else "")
            if name:
                args += ["-name", name]
            if d:
                args += ["-dir", d]
            pop.popdown()
            self.open_tab(idx, args, h["name"] + " · " + (name or "shell"))
        for e in (e_cmd, e_name, e_dir):
            e.connect("activate", launch)
        go.connect("clicked", launch)
        for r, wdg in enumerate((e_cmd, e_name, e_dir, go)):
            g.attach(wdg, 0, r, 1, 1)
        adv.add(g)
        box.pack_start(adv, False, False, 0)
        pop.add(box)
        pop.show_all()
        if first:
            first.grab_focus()

        def got(res):
            if not pop.get_visible():
                return
            for c in live.get_children():
                live.remove(c)
            sessions = (res or {}).get("sessions") or []
            if res is None or (res.get("error") and not sessions):
                msg = "não consegui consultar o host"
            elif not sessions:
                msg = "nenhuma sessão tmux viva"
            else:
                msg = None
            if msg:
                live.pack_start(cls(Gtk.Label(label=msg, xalign=0), "sub"), False, False, 0)
            for s in sessions:
                if s["name"] in btns:
                    btns[s["name"]].set_text("● rodando · " + s["command"])
                    cls(btns[s["name"]], "running")
                r = Gtk.Box(spacing=6)
                l = Gtk.Label(xalign=0)
                l.set_markup("<span foreground='#86d96b'>●</span> <b>%s</b>  <small>%s</small>" % (
                    esc(s["name"]), esc(s["command"])))
                r.pack_start(l, True, True, 0)
                ob = Gtk.Button(label="abrir")
                ob.connect("clicked", lambda _b, s=s: (pop.popdown(), self.open_session(idx, s["name"])))
                kb = Gtk.Button(label="encerrar")
                kb.connect("clicked", lambda _b, s=s, r=r: self.kill_remote(idx, h, s["name"], r))
                r.pack_end(kb, False, False, 0)
                r.pack_end(ob, False, False, 0)
                live.pack_start(r, False, False, 0)
            live.show_all()
        in_thread(lambda: casca("ls", str(idx), timeout=15), got)

    def kill_remote(self, idx, h, name, rowbox):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.OK_CANCEL,
                              text='Encerrar a sessão "%s" em %s?' % (name, h.get("name")))
        d.format_secondary_text("O que estiver rodando nela morre.")
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        if ok:
            def done(rc):
                if rc == 0:
                    rowbox.destroy()
                    self.live[idx] = [s for s in self.live.get(idx, []) if s["name"] != name]
                    self.render_home()
                else:
                    self.toast("não consegui encerrar")
            in_thread(lambda: subprocess.run([CASCA, "kill", "-conf", CONF, str(idx), name],
                                             capture_output=True, timeout=20).returncode, done)

    # ---------- abas ----------
    def open_agent(self, idx, agent):
        h = self.cfg["hosts"][idx]
        self.open_tab(idx, ["-agent", agent], h["name"] + " · " + agent)

    def open_session(self, idx, name):
        """Sessão viva pelo nome; as dos agentes (c-NOME) caem na mesma aba do agente."""
        for a in self.cfg["agents"]:
            if name == "c-" + a["name"]:
                return self.open_agent(idx, a["name"])
        self.open_tab(idx, ["-attach", name], self.cfg["hosts"][idx]["name"] + " · " + name)

    def open_tab(self, idx, args, label):
        # Uma aba por sessão: se já está aberta, só mostra.
        for i, p in enumerate(self.terms()):
            if p.key == (idx, tuple(args)):
                self.nb.set_current_page(i)
                self.show_tabs()
                return
        term = Vte.Terminal()
        term.key = (idx, tuple(args))
        term.idx = idx
        term.title = label
        term.short = label.split(" · ", 1)[-1]
        a = list(args)
        term.tmux = ("c-" + a[a.index("-agent") + 1] if "-agent" in a else
                     a[a.index("-attach") + 1] if "-attach" in a else
                     a[a.index("-name") + 1] if "-name" in a else term.short)
        term.row = term.row_dot = term.row_name = term.row_meta = None
        term.topic = ""
        term.state = "idle"
        term.ev = []
        term.last_key = 0.0
        term.work_since = 0.0
        term.set_scrollback_lines(2000)
        term.set_scroll_on_keystroke(True)
        term.set_mouse_autohide(True)
        term.set_audible_bell(False)
        term.set_colors(rgba("#e6e6e6"), rgba("#141414"), [rgba(c) for c in PALETTE])
        term.set_color_cursor(rgba("#ececec"))
        self.apply_font(term)
        term.set_margin_start(8)
        term.set_margin_end(4)
        term.set_margin_top(4)

        tab = Gtk.Box(spacing=6)
        term.dot = cls(Gtk.Label(label="●"), "mono", "st-idle")
        mark, color = mark_of(term.tmux)
        ml = Gtk.Label()
        ml.set_markup("<span foreground='%s'>%s</span>" % (color, mark))
        term.lab = cls(Gtk.Label(label=label), "tablabel")
        close = Gtk.Button(label="×")
        close.set_can_focus(False)
        close.set_tooltip_text("fechar aba (o tmux continua no host)")
        close.connect("clicked", lambda *_: self.close_tab(term))
        for w in (term.dot, ml, term.lab):
            tab.pack_start(w, False, False, 0)
        tab.pack_end(close, False, False, 0)
        tab.show_all()
        n = self.nb.append_page(term, tab)
        self.nb.set_tab_reorderable(term, True)
        term.connect("child-exited", lambda t, _st: self.close_tab(t))
        term.connect("bell", self.on_bell)
        term.connect("contents-changed", self.on_activity)
        term.connect("window-title-changed", self.on_title)
        term.connect("key-press-event", self.on_term_key)
        term.connect("button-press-event", self.on_term_button)
        term.show()
        self.rebuild_side()
        self.nb.set_current_page(n)
        self.show_tabs()
        argv = [CASCA, "connect", "-conf", CONF] + list(args) + [str(idx)]
        term.spawn_async(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"), argv, None,
                         GLib.SpawnFlags.DEFAULT, None, None, -1, None, None)

    def close_tab(self, term):
        n = self.nb.page_num(term)
        if n >= 0:
            self.nb.remove_page(n)   # fecha o pty: o ssh local morre, o tmux remoto fica
        self.rebuild_side()
        self.sync_empty()
        self.live_at = 0

    def sync_empty(self):
        if self.nb.get_n_pages() == 0:
            self.show_home()

    def current(self):
        n = self.nb.get_current_page()
        return self.nb.get_nth_page(n) if n >= 0 else None

    def on_switch(self, _nb, page, _n):
        if self.on_tabs():
            self.retitle(page.title)
        GLib.idle_add(self.after_switch)

    def after_switch(self):
        self.seen_current()
        self.mark_current()
        t = self.current()
        if t and self.on_tabs():
            t.grab_focus()
        return False

    # ---------- estado de cada sessão ----------
    def looking_at(self, term):
        return term is self.current() and self.on_tabs() and self.is_active()

    def seen_current(self):
        t = self.current()
        if t and t.state == "attn" and self.looking_at(t):
            self.set_state(t, "idle")
        if not any(x.state == "attn" for x in self.terms()):
            self.set_urgency_hint(False)

    def set_state(self, term, state):
        if term.state == state:
            return
        term.state = state
        self.paint_term(term)
        if state == "attn":
            self.set_urgency_hint(True)

    def paint_term(self, term):
        text = STATE_TEXT[term.state] + (" · " + term.topic if term.topic else "")
        # título de shell é só o nome da máquina; o de agente diz o que ele está fazendo
        topic = term.topic if (" " in term.topic or not term.topic[:1].isalnum()) else ""
        topic = topic.lstrip("✳✻* ").strip()
        for dot in (getattr(term, "dot", None), term.row_dot):
            if dot is None:
                continue
            ctx = dot.get_style_context()
            for c in ("st-idle", "st-working", "st-attn"):
                ctx.remove_class(c)
            ctx.add_class("st-" + term.state)
        if getattr(term, "lab", None) is not None:
            ctx = term.lab.get_style_context()
            (ctx.add_class if term.state == "attn" else ctx.remove_class)("attn")
            full = topic or term.title
            term.lab.set_text(full if len(full) <= 30 else full[:29] + "…")
            term.lab.get_parent().set_tooltip_text(term.title + "\n" + text)
        if term.row is not None:
            ctx = term.row.box.get_style_context()
            (ctx.add_class if term.state == "attn" else ctx.remove_class)("attn")
            term.row_name.set_text(topic or term.short)
            term.row.set_tooltip_text(term.title + "\n" + text)
        if term is self.current() and hasattr(self, "snip_state"):
            self.snip_state.set_text(term.title + "   " + text)

    def on_activity(self, term):
        now = time.monotonic()
        if now - term.last_key > 1.0:    # eco do que você digita não é o agente trabalhando
            term.ev.append(now)

    def tick(self):
        now = time.monotonic()
        for t in self.terms():
            t.ev = [x for x in t.ev if now - x < 3]
            if len(t.ev) >= 3:
                if t.state != "working":
                    t.work_since = now
                    self.set_state(t, "working")
            elif t.state == "working" and (not t.ev or now - t.ev[-1] > 2.5):
                # trabalhou um tempo e parou sem você estar olhando: avisa
                long = now - t.work_since >= 8
                self.set_state(t, "attn" if long and not self.looking_at(t) else "idle")
        cur = self.current()
        if cur and hasattr(self, "snip_state"):
            self.snip_state.set_text(cur.title + "   " + STATE_TEXT[cur.state] + (" · " + cur.topic if cur.topic else ""))
        return True

    def spin_tick(self):
        self.spin = (self.spin + 1) % len(SPIN)
        for t in self.terms():
            want = SPIN[self.spin] if t.state == "working" else "●"
            for dot in (getattr(t, "dot", None), t.row_dot):
                if dot is not None and dot.get_text() != want:
                    dot.set_text(want)
        return True

    def on_bell(self, term):
        # O sino é o único aviso explícito de agente que atravessa o tmux.
        if not self.looking_at(term):
            self.set_state(term, "attn")

    def on_title(self, term):
        t = (term.get_window_title() or "").strip()
        term.topic = t[:60]
        self.paint_term(term)

    def feed(self, text):
        t = self.current()
        if not t or not text:
            return
        data = text.encode()
        try:
            t.feed_child(data)
        except TypeError:
            t.feed_child(text, len(data))
        t.grab_focus()

    # ---------- teclas ----------
    def apply_font(self, term):
        term.set_font(Pango.FontDescription("JetBrains Mono, monospace %d" % self.font_size))

    def set_font(self, delta):
        self.font_size = max(6, min(28, self.font_size + delta))
        for t in self.terms():
            self.apply_font(t)

    def on_term_button(self, term, ev):
        # Com o mouse do tmux ligado o clique direito é dele; Ctrl+clique direito abre este menu.
        if ev.button != 3 or not (ev.state & Gdk.ModifierType.CONTROL_MASK):
            return False
        m = Gtk.Menu()
        for text, fn in (("copiar", lambda *_: term.copy_clipboard_format(Vte.Format.TEXT)),
                         ("colar", lambda *_: term.paste_clipboard()),
                         ("fechar aba (tmux continua)", lambda *_: self.close_tab(term))):
            it = Gtk.MenuItem(label=text)
            it.connect("activate", fn)
            m.append(it)
        m.show_all()
        m.popup_at_pointer(ev)
        return True

    def on_term_key(self, term, ev):
        term.last_key = time.monotonic()
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        k = Gdk.keyval_name(ev.keyval) or ""
        if ctrl and shift and k.lower() == "c":
            term.copy_clipboard_format(Vte.Format.TEXT)
            return True
        if ctrl and shift and k.lower() == "v":
            term.paste_clipboard()
            return True
        if shift and k == "Insert":
            term.paste_primary()
            return True
        return False

    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        alt = ev.state & Gdk.ModifierType.MOD1_MASK
        k = Gdk.keyval_name(ev.keyval) or ""
        n = self.nb.get_n_pages()
        if ctrl and k in ("Page_Up", "Page_Down") and n:
            self.nb.set_current_page((self.nb.get_current_page() + (1 if k == "Page_Down" else -1)) % n)
            self.show_tabs()
            return True
        if alt and not ctrl and k in "123456789" and len(k) == 1 and int(k) <= n:
            self.nb.set_current_page(int(k) - 1)
            self.show_tabs()
            return True
        if ctrl and shift and k.lower() in ("t", "k"):
            self.show_home()
            return True
        if ctrl and shift and k.lower() == "h":
            self.show_tabs() if not self.on_tabs() else self.show_home()
            return True
        if ctrl and shift and k.lower() == "w":
            t = self.current()
            if t and self.on_tabs():
                self.close_tab(t)
            return True
        if ctrl and k in ("plus", "equal", "KP_Add"):
            self.set_font(1)
            return True
        if ctrl and k in ("minus", "KP_Subtract"):
            self.set_font(-1)
            return True
        if k == "F11":
            (self.unfullscreen if getattr(self, "_fs", False) else self.fullscreen)()
            self._fs = not getattr(self, "_fs", False)
            return True
        if k == "Escape" and not self.on_tabs() and n:
            self.search.set_text("")
            self.show_tabs()
            return True
        return False

    # ---------- abrir por fora (casca-gui --open HOST[:AGENTE]) ----------
    def do_open(self, specs):
        for spec in specs:
            name, _, agent = spec.partition(":")
            agent = agent or (self.cfg["agents"][0]["name"] if self.cfg["agents"] else "shell")
            for idx, h in enumerate(self.cfg["hosts"]):
                if name.lower() in (h.get("name", "").lower(), h.get("target", "").lower(), str(idx)):
                    self.open_agent(idx, agent)
                    break
            else:
                print("host desconhecido:", name, file=sys.stderr)
        self.present()

    def serve(self):
        """Uma janela só: um segundo casca-gui entrega o pedido aqui e sai."""
        try:
            if os.path.exists(SOCK):
                os.unlink(SOCK)
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(SOCK)
            os.chmod(SOCK, 0o600)
            srv.listen(4)
        except OSError as e:
            print("socket:", e, file=sys.stderr)
            return
        self._srv = srv

        def accept(*_):
            try:
                c, _a = srv.accept()
                c.settimeout(1)
                data = c.recv(8192)
                c.close()
                self.do_open(json.loads(data.decode() or "[]"))
            except Exception as e:
                print("pedido:", e, file=sys.stderr)
            return True
        GLib.io_add_watch(srv.fileno(), GLib.IO_IN, accept)

    def on_quit(self, *_):
        try:
            w, h = self.get_size()
            json.dump({"font": self.font_size, "w": w, "h": h}, open(STATE, "w"))
        except Exception:
            pass
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        Gtk.main_quit()
        return False


def hand_over(specs):
    """Se já existe uma janela, manda ela abrir e devolve True."""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(2)
        c.connect(SOCK)
        c.sendall(json.dumps(specs).encode())
        c.close()
        return True
    except OSError:
        return False


def main():
    args = sys.argv[1:]
    specs = [args[i + 1] for i, a in enumerate(args) if a == "--open" and i + 1 < len(args)]
    if hand_over(specs):
        return 0
    if not CASCA:
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE,
                              text="não achei o binário casca (esperado em ~/.local/bin/casca)")
        d.run()
        return 1
    if not os.path.exists(CONF):
        subprocess.run([CASCA, "init", "-conf", CONF], capture_output=True)
    app = App()
    app.serve()
    if specs:
        app.do_open(specs)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
