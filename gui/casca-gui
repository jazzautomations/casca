    def st_of(self, idx):
        return (self.status[idx] if idx < len(self.status) else None) or "unknown"

    def render_home(self):
        keep = self.sel_idx
        for c in self.rows.get_children():
            self.rows.remove(c)
        hosts = self.cfg["hosts"]
        searching = bool(self.search.get_text().strip())
        order = sorted(range(len(hosts)), key=lambda i: (self.st_of(i) == "down", i))
        first, kept, off = None, None, []
        for i in order:
            if not self.match_host(hosts[i]):
                continue
            if self.st_of(i) == "down":
                off.append(hosts[i].get("name", "?"))
                if not (self.show_off or searching):
                    continue
            row = self.make_row(i, hosts[i])
            self.rows.add(row)
            first = first or row
            if i == keep:
                kept = row
        up = sum(1 for i in range(len(hosts)) if self.st_of(i) == "up")
        n = len(self.terms())
        txt = "%d online  ·  %d fora" % (up, len(hosts) - up)
        if n:
            txt += "  ·  %d %s" % (n, "sessão aberta" if n == 1 else "sessões abertas")
        if self.live_busy:
            txt += "  ·  procurando sessões vivas…"
        self.home_sub.set_text(txt)
        self.rows.show_all()
        self.select(kept or first)

