AGENT_MARK = {"shell": ("❯", "#8e8e8e"), "claude": ("✻", "#d97757"), "codex": ("⬡", "#7cc4a4"),
              "devin": ("◆", "#6ea8fe"), "jazz": ("♪", "#c792ea")}
