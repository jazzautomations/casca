def mark_of(name):
    """Símbolo e cor de uma sessão pelo nome (c-claude, claude, devin-p0...)."""
    n = name[2:] if name.startswith("c-") else name
    for k, v in AGENT_MARK.items():
        if n == k or n.startswith(k + "-"):
            return v
    return ("▪", "#7a7a7a")


def age(ts):
    d = max(0, int(time.time() - ts)) if ts else None
    if d is None:
        return ""
    if d < 90:
        return "agora"
    if d < 3600:
        return "%dm" % (d // 60)
    if d < 86400:
        return "%dh" % (d // 3600)
    return "%dd" % (d // 86400)

