def find_casca():
    here = os.path.dirname(os.path.realpath(__file__))
    for c in (os.environ.get("CASCA_BIN"), os.path.join(here, "casca"), os.path.join(here, "..", "casca"),
              os.path.expanduser("~/.local/bin/casca"), shutil.which("casca")):
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return os.path.realpath(c)
    return None


