def rgba(s):
    c = Gdk.RGBA()
    c.parse(s)
    return c


def esc(s):
    return GLib.markup_escape_text(s or "")


def cls(w, *names):
    for n in names:
        w.get_style_context().add_class(n)
    return w


def casca(*args, timeout=20):
    """Roda um comando curto do casca e devolve o JSON (ou None)."""
    try:
        out = subprocess.run([CASCA, args[0], "-conf", CONF] + list(args[1:]),
                             capture_output=True, timeout=timeout).stdout
        return json.loads(out or b"null")
    except Exception:
        return None


def in_thread(fn, done):
    """Roda fn fora da thread da interface e entrega o resultado nela."""
    def work():
        res = fn()
        GLib.idle_add(done, res)
    threading.Thread(target=work, daemon=True).start()


